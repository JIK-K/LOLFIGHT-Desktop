{
  "name": "lolfight-desktop",
  "description": "A simple application with many useful functions which work with the LCU api of Riot Games ",
  "version": "1.0.0",
  "author": "LOLFIGHT",
  "license": "MIT",
  "private": true,
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "biome lint ./src",
    "publish": "electron-forge publish"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "assets/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "LOLFIGHT",
            "setupIcon": "assets/icon.ico",
            "loadingGif": "install.gif"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ],
          "config": {
            "name": "LOLFIGHT",
            "icons": "assets/icon.ico",
            "loadingGif": "install.gif"
          }
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "mainConfig": "./webpack.main.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./src/renderer/index.html",
                  "js": "./src/renderer/index.ts",
                  "name": "main"
                }
              ]
            },
            "port": 5000
          }
        }
      ],
      "publishers": [
        {
          "name": "@electron-forge/publisher-github",
          "config": {
            "repository": {
              "owner": "JIK-K",
              "name": "LOLFIGHT-Desktop"
            },
            "prerelease": false,
            "draft": false
          }
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JIK-K/LOLFIGHT-Desktop.git"
  },
  "build": {},
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-webpack": "^7.2.0",
    "@electron-forge/publisher-github": "^7.4.0",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "electron": "28.2.1",
    "electron-devtools-installer": "^3.2.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "node-loader": "^2.0.0",
    "postcss-loader": "^8.1.1",
    "sass": "^1.77.4",
    "sass-loader": "^14.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.3",
    "ts-loader": "^9.5.1",
    "typescript": "~5.3.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-switch": "^1.0.3",
    "antd": "^5.15.2",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "electron-log": "^5.1.5",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^8.1.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "league-connect": "6.0.0-rc12",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "sweetalert2": "^11.10.5",
    "update-electron-app": "^3.0.0",
    "uuid": "^9.0.1",
    "webpack": "^5.91.0",
    "webpack-dev-server": "^5.0.4",
    "ws": "^8.16.0",
    "zustand": "^4.5.2"
  }
}
